# Secrets for docker-compose.override.yml. Compose reads this file automatically.
# Copy to src/.env and fill in. SQL Server needs 8+ chars with upper, lower and a digit.
# Postgres and Keycloak only apply the password when their volume is first created.
ORDERDB_SA_PASSWORD=change-me-Str0ng
CATALOGDB_PASSWORD=change-me
BASKETDB_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
PGADMIN_PASSWORD=change-me
